# AI 海报画布 canvas-web — Docker / CloudBase 用（复制为 canvas-web.env 后填写）
# cp deploy/tencent/canvas-web.env.example deploy/tencent/canvas-web.env

NODE_ENV=production

# 主站 Origin（SSO exchange / 门户 BFF / 退出 federated 链）
MAIN_SITE_ORIGIN=https://book.ai-code8.com
NEXT_PUBLIC_BOOK_MALL_URL=https://book.ai-code8.com
BOOK_MALL_URL=https://book.ai-code8.com

# 须与 book-mall 中完全一致（缺则登录 503「未配置 TOOLS_SSO_SERVER_SECRET」；错则 exchange_401）
TOOLS_SSO_SERVER_SECRET=与主站相同至少16位
TOOLS_SSO_JWT_SECRET=与主站相同另一条至少16位

# 本服务公网 Origin
NEXT_PUBLIC_CANVAS_WEB_ORIGIN=https://canvas.ai-code8.com
CANVAS_PUBLIC_ORIGIN=https://canvas.ai-code8.com

# 跨门户导航（可选）
NEXT_PUBLIC_TOOL_WEB_ORIGIN=https://tool.ai-code8.com
NEXT_PUBLIC_STORY_WEB_ORIGIN=https://story.ai-code8.com
NEXT_PUBLIC_GATEWAY_WEB_ORIGIN=https://gateway.ai-code8.com

# 云托管默认域临时调试
# ALLOW_CLOUDBASE_DEFAULT_ORIGINS=1
